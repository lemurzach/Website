# PostgreSQL connection string (Neon, Supabase, Vercel Postgres, Railway, etc. all work)
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# Random 32+ byte secret used to sign the admin session cookie.
# Generate one with: openssl rand -base64 32
SESSION_SECRET="replace-with-a-long-random-string"

# Bcrypt hash of your admin password (never store the plain password).
# Generate one with: node scripts/hash-password.mjs "your-password-here"
#
# IMPORTANT: bcrypt hashes contain "$" characters (e.g. $2b$12$...), and
# Next.js expands "$name" in .env files as a variable reference. Escape
# every "$" as "\$" or the hash will be silently corrupted at runtime.
# The hash-password.mjs script prints the value already escaped this way
# for copy-pasting straight into this file.
ADMIN_PASSWORD_HASH="replace-with-a-bcrypt-hash"
