# -----------------------------------------------------------------------------
# Environment variables
#
# Copy this file to `.env.local` for local development:  cp .env.example .env.local
# On Vercel, add the same keys under Project -> Settings -> Environment Variables.
#
# Anything prefixed NEXT_PUBLIC_ is bundled into browser JavaScript and is
# PUBLIC. Never put a secret in a NEXT_PUBLIC_ variable.
#
# The "Phase" note on each block says when the key is first needed (see PLAN.md).
# -----------------------------------------------------------------------------


# --- App ---------------------------------------------------------------------

# Public base URL of the app, no trailing slash. Used to build OAuth redirect
# URIs, Stripe return URLs and links in emails.
# Local: http://localhost:3000   Production: https://app.yourdomain.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Product name shown in the UI. Placeholder until the brand is decided.
NEXT_PUBLIC_APP_NAME="Local Reputation"


# --- Supabase (Phase 1) ------------------------------------------------------
# Supabase dashboard -> Project Settings -> API (and API Keys).

# Project URL, e.g. https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Publishable key (sb_publishable_...). Safe for the browser; Row Level
# Security is what protects the data. A legacy "anon" key also works here.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret key (sb_secret_...) or legacy "service_role" key. SERVER ONLY.
# Bypasses Row Level Security: used by webhooks, cron jobs and the public
# Reputation Score endpoint. Never expose to the browser.
SUPABASE_SECRET_KEY=


# --- Security (Phase 4) ------------------------------------------------------

# 32-byte key, base64-encoded, used to encrypt Facebook/Instagram/Google OAuth
# tokens before they are stored in Postgres (AES-256-GCM via Node's crypto).
# Generate with:  openssl rand -base64 32
# Rotating it makes every stored token unreadable (customers must reconnect).
TOKEN_ENCRYPTION_KEY=

# Shared secret that Vercel Cron sends as "Authorization: Bearer <CRON_SECRET>"
# so only Vercel can trigger the scheduled-post publisher and review sync jobs.
# Generate with:  openssl rand -hex 32
CRON_SECRET=


# --- Anthropic / Claude API (Phase 2) ----------------------------------------
# https://console.anthropic.com -> API Keys

# SERVER ONLY. Used for onboarding (reading the business's website),
# post generation and review reply drafts.
ANTHROPIC_API_KEY=

# Optional. Model used for all generation. Defaults to claude-opus-5-5.
# Cheaper options for high-volume short text: claude-sonnet-5-5, claude-haiku-5-5.
ANTHROPIC_MODEL=claude-opus-5-5


# --- Meta: Facebook Pages + Instagram (Phase 4) ------------------------------
# https://developers.facebook.com -> My Apps -> your app -> App settings -> Basic
# Add "Facebook Login for Business" and add this as a valid OAuth redirect URI:
#   ${NEXT_PUBLIC_APP_URL}/api/integrations/meta/callback
# Publishing for customers needs App Review for pages_manage_posts,
# pages_read_engagement, instagram_basic and instagram_content_publish.

META_APP_ID=

# SERVER ONLY.
META_APP_SECRET=

# Graph API version to pin requests to, e.g. v23.0. Bump deliberately.
META_GRAPH_API_VERSION=v23.0


# --- Google: Business Profile + Places (Phases 1, 5, 7) ----------------------
# https://console.cloud.google.com -> APIs & Services -> Credentials

# OAuth 2.0 Client (type "Web application"). Used to connect a customer's
# Google Business Profile (scope: https://www.googleapis.com/auth/business.manage).
# Authorized redirect URI:
#   ${NEXT_PUBLIC_APP_URL}/api/integrations/google/callback
# Business Profile APIs require an access request to Google; apply early.
# (Sign in with Google for app login is configured in the Supabase dashboard,
# not here.)
GOOGLE_CLIENT_ID=

# SERVER ONLY.
GOOGLE_CLIENT_SECRET=

# SERVER ONLY. API key restricted to "Places API (New)". Used by the listings
# scan and the public Reputation Score page to look up a business by name or
# address without the owner connecting anything. Set a daily quota.
GOOGLE_PLACES_API_KEY=


# --- Other listing sources for the scan (Phase 7, optional) ------------------

# SERVER ONLY. Yelp Fusion API key (https://www.yelp.com/developers).
# Leave blank to skip Yelp in the listings scan.
YELP_API_KEY=


# --- Stripe (Phase 9) --------------------------------------------------------
# https://dashboard.stripe.com -> Developers -> API keys. Use test keys locally.

# SERVER ONLY. sk_test_... / sk_live_...
STRIPE_SECRET_KEY=

# pk_test_... / pk_live_... Safe for the browser.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# SERVER ONLY. Signing secret for the webhook endpoint (whsec_...).
# Local: printed by `stripe listen --forward-to localhost:3000/api/stripe/webhook`
# Production: Dashboard -> Developers -> Webhooks -> your endpoint.
STRIPE_WEBHOOK_SECRET=

# Price ID (price_...) of the flat monthly plan.
STRIPE_PRICE_ID=
