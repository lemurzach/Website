{% comment %}
  Render: {% render 'product-card', product: product, show_attrs: true %}
{% endcomment %}

{%- liquid
  assign on_sale = false
  if product.compare_at_price > product.price
    assign on_sale = true
  endif
-%}

<article class="pc" data-product-id="{{ product.id }}">

  <!-- Media -->
  <a href="{{ product.url }}" class="pc__media" tabindex="-1" aria-label="{{ product.title }}">

    <!-- Primary image -->
    {%- if product.featured_image -%}
      <img
        src="{{ product.featured_image | image_url: width: 600, height: 600, crop: 'center' }}"
        alt="{{ product.featured_image.alt | escape | default: product.title }}"
        class="pc__img"
        loading="lazy"
        width="600" height="600"
      >
    {%- else -%}
      {{ 'product-1' | placeholder_svg_tag: 'pc__img' }}
    {%- endif -%}

    <!-- Hover image -->
    {%- if product.images[1] -%}
      <img
        src="{{ product.images[1] | image_url: width: 600, height: 600, crop: 'center' }}"
        alt="{{ product.images[1].alt | escape }}"
        class="pc__img-2"
        loading="lazy"
        width="600" height="600"
      >
    {%- endif -%}

    <!-- Badges -->
    <div class="pc__badges">
      {%- unless product.available -%}
        <span class="badge badge--sold-out">Sold Out</span>
      {%- else -%}
        {%- if on_sale -%}
          {%- assign save_pct = product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price -%}
          <span class="badge badge--sale">−{{ save_pct }}%</span>
        {%- endif -%}
        {%- for tag in product.tags -%}
          {%- if tag == 'new' or tag == 'New' -%}
            <span class="badge badge--new">New</span>
          {%- elsif tag == 'vegan' or tag == 'Vegan' -%}
            <span class="badge badge--vegan">Vegan</span>
          {%- elsif tag == 'gluten-free' or tag == 'Gluten Free' -%}
            <span class="badge badge--gf">GF</span>
          {%- elsif tag contains 'badge:' -%}
            <span class="badge badge--custom">{{ tag | remove: 'badge:' | strip }}</span>
          {%- endif -%}
        {%- endfor -%}
      {%- endunless -%}
    </div>

    <!-- Variant colour swatches -->
    {%- assign color_option = nil -%}
    {%- for option in product.options_with_values -%}
      {%- if option.name == 'Color' or option.name == 'Colour' or option.name == 'Flavor' or option.name == 'Flavour' -%}
        {%- assign color_option = option -%}
      {%- endif -%}
    {%- endfor -%}

    {%- if color_option != nil and color_option.values.size > 1 -%}
      <div class="pc__swatches" aria-hidden="true">
        {%- for val in color_option.values limit: 5 -%}
          <span
            class="pc__swatch{% if forloop.first %} is-active{% endif %}"
            data-color="{{ val | handle }}"
            title="{{ val }}"
            style="background: {{ val | downcase | replace: ' ', '-' }}"
          ></span>
        {%- endfor -%}
        {%- if color_option.values.size > 5 -%}
          <span class="pc__swatch" style="background:var(--c-gray-2);display:flex;align-items:center;justify-content:center;font-size:.55rem;font-weight:700;color:var(--c-gray-4)">+{{ color_option.values.size | minus: 5 }}</span>
        {%- endif -%}
      </div>
    {%- endif -%}

    <!-- Quick Add -->
    {%- if product.available -%}
      <div class="pc__quick-add">
        <button
          type="button"
          class="btn btn--primary btn--sm btn--full"
          onclick="event.preventDefault(); addToCart('{{ product.selected_or_first_available_variant.id }}', 1)"
          aria-label="Quick add {{ product.title }}"
        >Quick Add</button>
      </div>
    {%- endif -%}

  </a>

  <!-- Info -->
  <div class="pc__info">
    {%- if product.vendor != blank -%}
      <span class="pc__brand">{{ product.vendor }}</span>
    {%- endif -%}

    <h3 class="pc__title">
      <a href="{{ product.url }}">{{ product.title }}</a>
    </h3>

    <!-- Attribute badges row (from tags) -->
    {%- assign has_attrs = false -%}
    {%- for tag in product.tags -%}
      {%- if tag == 'vegan' or tag == 'Vegan' or tag == 'gluten-free' or tag == 'Gluten Free' or tag contains 'kcal:' or tag contains 'attr:' -%}
        {%- assign has_attrs = true -%}
      {%- endif -%}
    {%- endfor -%}

    {%- if has_attrs -%}
      <div class="pc__attrs">
        {%- for tag in product.tags -%}
          {%- if tag == 'vegan' or tag == 'Vegan' -%}
            <span class="badge badge--vegan" style="font-size:.6rem">Vegan</span>
          {%- elsif tag == 'gluten-free' or tag == 'Gluten Free' -%}
            <span class="badge badge--gf" style="font-size:.6rem">GF</span>
          {%- elsif tag contains 'kcal:' -%}
            <span class="badge badge--custom" style="font-size:.6rem">{{ tag | remove: 'kcal:' | strip }} kcal</span>
          {%- elsif tag contains 'attr:' -%}
            <span class="badge badge--custom" style="font-size:.6rem">{{ tag | remove: 'attr:' | strip }}</span>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

    <div class="pc__price">
      <span class="price{% if on_sale %} price--on{% endif %}">{{ product.price | money }}</span>
      {%- if on_sale -%}
        <span class="price price--was">{{ product.compare_at_price | money }}</span>
      {%- endif -%}
    </div>
  </div>

</article>
