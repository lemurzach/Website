<div style="padding:var(--spacing-xl) 0">
  <div class="container">
    <div style="max-width:600px;margin:0 auto var(--spacing-xl)">
      <h1 style="font-size:2rem;font-weight:900;margin-bottom:1.5rem;text-align:center">
        {%- if search.performed -%}
          Results for "{{ search.terms }}"
        {%- else -%}
          Search
        {%- endif -%}
      </h1>
      <form action="{{ routes.search_url }}" method="get">
        <input type="hidden" name="type" value="product">
        <div class="search-modal__form" style="position:static;border:2px solid var(--color-gray-200);padding:0 1.25rem;border-radius:var(--radius-pill)">
          <input
            class="search-modal__input"
            type="search"
            name="q"
            value="{{ search.terms | escape }}"
            placeholder="Search products..."
            autocomplete="off"
          >
          <button type="submit" class="search-modal__submit" aria-label="Search">
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
              <circle cx="9" cy="9" r="6" stroke="currentColor" stroke-width="1.5"/>
              <path d="M15 15l-2.5-2.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
            </svg>
          </button>
        </div>
      </form>
    </div>

    {%- if search.performed -%}
      {%- if search.results_count == 0 -%}
        <p style="text-align:center;color:var(--color-gray-600);padding:3rem 0">No results found for "{{ search.terms }}". Try a different search.</p>
      {%- else -%}
        <p style="margin-bottom:1.5rem;color:var(--color-gray-600)">{{ search.results_count }} results for "{{ search.terms }}"</p>
        <div class="product-grid product-grid--4">
          {%- for result in search.results -%}
            {%- if result.object_type == 'product' -%}
              {% render 'product-card', product: result %}
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Search"
}
{% endschema %}
