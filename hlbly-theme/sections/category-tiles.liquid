<section class="section-padding{% if section.settings.background == 'light' %} featured-collection--bg{% endif %}">
  <div class="container">
    <div class="section-header{% if section.settings.text_align == 'center' %} section-header--center{% endif %}">
      {%- if section.settings.eyebrow != blank -%}
        <span class="section-eyebrow">{{ section.settings.eyebrow }}</span>
      {%- endif -%}
      <h2 class="section-title">{{ section.settings.heading }}</h2>
    </div>
    <div class="category-tiles">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'tile' -%}
            <a href="{{ block.settings.link }}" class="category-tile" {{ block.shopify_attributes }}>
              {%- if block.settings.image != blank -%}
                <img
                  src="{{ block.settings.image | image_url: width: 600 }}"
                  alt="{{ block.settings.title }}"
                  class="category-tile__image"
                  loading="lazy"
                  width="600" height="800"
                >
              {%- else -%}
                {{ 'collection-' | append: forloop.index | placeholder_svg_tag: 'category-tile__image' }}
              {%- endif -%}
              <div class="category-tile__overlay"></div>
              <div class="category-tile__content">
                <p class="category-tile__title">{{ block.settings.title }}</p>
                {%- if block.settings.count != blank -%}
                  <p class="category-tile__count">{{ block.settings.count }}</p>
                {%- endif -%}
              </div>
            </a>
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Category Tiles",
  "settings": [
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "options": [
        { "value": "white", "label": "White" },
        { "value": "light", "label": "Light" }
      ],
      "default": "white"
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "Header Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "left"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Browse"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by Category"
    }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Category Tile",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Category Name",
          "default": "Category"
        },
        {
          "type": "text",
          "id": "count",
          "label": "Item Count (e.g. 12 products)"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Category Tiles",
      "blocks": [
        { "type": "tile", "settings": { "title": "Snacks" } },
        { "type": "tile", "settings": { "title": "Drinks" } },
        { "type": "tile", "settings": { "title": "Sauces" } },
        { "type": "tile", "settings": { "title": "Bundles" } }
      ]
    }
  ]
}
{% endschema %}
