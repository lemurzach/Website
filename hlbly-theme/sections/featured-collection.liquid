{%- assign coll = collections[section.settings.collection] -%}

<section class="section-pad{% if section.settings.background == 'sand' %}" style="background:var(--c-sand){% elsif section.settings.background == 'dark' %}" style="background:var(--c-dark);color:var(--c-white){% endif %}">
  <div class="container">

    <div class="sh{% if section.settings.header_align == 'center' %} sh--center{% endif %}" data-reveal style="display:flex;align-items:flex-end;justify-content:space-between;flex-wrap:wrap;gap:1rem">
      <div>
        {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
        <h2 class="sh__title" style="margin-bottom:0">{{ section.settings.heading }}</h2>
        {%- if section.settings.subheading != blank -%}<p class="sh__sub" style="margin-top:.625rem">{{ section.settings.subheading }}</p>{%- endif -%}
      </div>
      {%- if section.settings.cta_label != blank -%}
        <a href="{{ coll.url | default: section.settings.cta_url }}" class="btn btn--outline{% if section.settings.background == 'dark' %}-w{% endif %}" style="flex-shrink:0">
          {{ section.settings.cta_label }}
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M2 7h10M8 3l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
      {%- endif -%}
    </div>

    <div class="product-grid" style="--cols:{{ section.settings.columns }}">
      {%- for product in coll.products limit: section.settings.count -%}
        {% render 'product-card', product: product %}
      {%- else -%}
        {%- for i in (1..section.settings.count) -%}
          <article class="pc">
            <div class="pc__media" style="aspect-ratio:1;background:var(--c-gray-1)">
              {{ 'product-' | append: forloop.index | placeholder_svg_tag: 'pc__img' }}
            </div>
            <div class="pc__info">
              <h3 class="pc__title"><a href="#">Sample Product {{ forloop.index }}</a></h3>
              <div class="pc__price"><span class="price">$24.99</span></div>
            </div>
          </article>
        {%- endfor -%}
      {%- endfor -%}
    </div>

    {%- if section.settings.cta_label_bottom != blank -%}
      <div style="text-align:center;margin-top:2.5rem" data-reveal>
        <a href="{{ coll.url | default: section.settings.cta_url }}" class="btn btn--primary btn--lg">{{ section.settings.cta_label_bottom }}</a>
      </div>
    {%- endif -%}

  </div>
</section>

{% schema %}
{
  "name": "Featured Collection",
  "settings": [
    { "type": "collection", "id": "collection", "label": "Collection" },
    {
      "type": "select", "id": "background", "label": "Background",
      "options": [
        { "value": "white", "label": "White" },
        { "value": "sand",  "label": "Sand / Warm" },
        { "value": "dark",  "label": "Dark" }
      ],
      "default": "white"
    },
    {
      "type": "select", "id": "header_align", "label": "Header alignment",
      "options": [{ "value": "left", "label": "Left" }, { "value": "center", "label": "Centre" }],
      "default": "left"
    },
    { "type": "text", "id": "eyebrow",    "label": "Eyebrow",    "default": "Featured" },
    { "type": "text", "id": "heading",    "label": "Heading",    "default": "Best Sellers" },
    { "type": "text", "id": "subheading", "label": "Subheading" },
    {
      "type": "select", "id": "columns", "label": "Columns",
      "options": [
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" }
      ],
      "default": "4"
    },
    { "type": "range", "id": "count", "label": "Products to show", "min": 2, "max": 12, "step": 1, "default": 4 },
    { "type": "text", "id": "cta_label",        "label": "Header CTA label",  "default": "View All" },
    { "type": "url",  "id": "cta_url",          "label": "CTA URL (fallback)" },
    { "type": "text", "id": "cta_label_bottom", "label": "Bottom CTA label (optional)" }
  ],
  "presets": [{ "name": "Featured Collection" }]
}
{% endschema %}
