<section class="section-pad{% if section.settings.background == 'sand' %}" style="background:var(--c-sand){% elsif section.settings.background == 'dark' %}" style="background:var(--c-dark);color:var(--c-white){% endif %}">
  <div class="container">
    <div class="iwt{% if section.settings.image_side == 'right' %} iwt--reverse{% endif %}">

      <div class="iwt__media" data-reveal>
        {%- if section.settings.image != blank -%}
          <img
            src="{{ section.settings.image | image_url: width: 900 }}"
            alt="{{ section.settings.image.alt | escape | default: section.settings.heading }}"
            loading="lazy"
            width="900"
          >
        {%- else -%}
          {{ 'image' | placeholder_svg_tag }}
        {%- endif -%}
      </div>

      <div class="iwt__content" data-reveal data-reveal-delay="2">
        {%- if section.settings.eyebrow != blank -%}
          <span class="eyebrow">{{ section.settings.eyebrow }}</span>
        {%- endif -%}
        <h2 class="iwt__title">{{ section.settings.heading }}</h2>
        {%- if section.settings.text != blank -%}
          <div class="iwt__body">{{ section.settings.text }}</div>
        {%- endif -%}

        {%- if section.blocks.size > 0 -%}
          <div class="iwt__features">
            {%- for block in section.blocks -%}
              {%- case block.type -%}
                {%- when 'feature' -%}
                  <div class="iwt__feat" {{ block.shopify_attributes }}>
                    <span class="iwt__feat-icon">{{ block.settings.icon }}</span>
                    <div>
                      <p class="iwt__feat-title">{{ block.settings.title }}</p>
                      {%- if block.settings.text != blank -%}
                        <p class="iwt__feat-sub">{{ block.settings.text }}</p>
                      {%- endif -%}
                    </div>
                  </div>
              {%- endcase -%}
            {%- endfor -%}
          </div>
        {%- endif -%}

        <div class="iwt__cta">
          {%- if section.settings.cta1_label != blank -%}
            <a href="{{ section.settings.cta1_url }}" class="btn btn--{{ section.settings.cta1_style }} btn--lg">{{ section.settings.cta1_label }}</a>
          {%- endif -%}
          {%- if section.settings.cta2_label != blank -%}
            <a href="{{ section.settings.cta2_url }}" class="btn btn--outline{% if section.settings.background == 'dark' %}-w{% endif %} btn--lg">{{ section.settings.cta2_label }}</a>
          {%- endif -%}
        </div>
      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Image with Text",
  "settings": [
    {
      "type": "select", "id": "background", "label": "Background",
      "options": [
        { "value": "white", "label": "White"      },
        { "value": "sand",  "label": "Sand / Warm" },
        { "value": "dark",  "label": "Dark"        }
      ],
      "default": "white"
    },
    {
      "type": "select", "id": "image_side", "label": "Image side",
      "options": [
        { "value": "left",  "label": "Left"  },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    { "type": "image_picker", "id": "image",    "label": "Image" },
    { "type": "text",         "id": "eyebrow",  "label": "Eyebrow" },
    { "type": "text",         "id": "heading",  "label": "Heading", "default": "Why HLBLY?" },
    { "type": "richtext",     "id": "text",     "label": "Body text", "default": "<p>We craft every product with real ingredients and bold flavours you can taste.</p>" },
    { "type": "text",         "id": "cta1_label", "label": "Button 1 label" },
    { "type": "url",          "id": "cta1_url",   "label": "Button 1 link" },
    {
      "type": "select", "id": "cta1_style", "label": "Button 1 style",
      "options": [
        { "value": "primary", "label": "Red (Primary)" },
        { "value": "dark",    "label": "Dark"          }
      ],
      "default": "primary"
    },
    { "type": "text", "id": "cta2_label", "label": "Button 2 label" },
    { "type": "url",  "id": "cta2_url",   "label": "Button 2 link" }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature Row",
      "settings": [
        { "type": "text", "id": "icon",  "label": "Emoji icon",   "default": "✓"               },
        { "type": "text", "id": "title", "label": "Title",         "default": "Feature title"   },
        { "type": "text", "id": "text",  "label": "Description",   "default": "Brief description." }
      ]
    }
  ],
  "presets": [{
    "name": "Image with Text",
    "blocks": [
      { "type": "feature", "settings": { "icon": "🌿", "title": "Natural Ingredients",  "text": "Zero artificial additives." } },
      { "type": "feature", "settings": { "icon": "🚀", "title": "Same-Day Dispatch",    "text": "Order before 2pm."          } },
      { "type": "feature", "settings": { "icon": "♻️", "title": "Sustainable Packaging","text": "100% recyclable materials."  } }
    ]
  }]
}
{% endschema %}
