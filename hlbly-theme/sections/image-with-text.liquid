<section class="section-padding{% if section.settings.background == 'light' %} featured-collection--bg{% endif %}{% if section.settings.background == 'dark' %}" style="background:var(--color-dark){% endif %}">
  <div class="container">
    <div class="image-with-text{% if section.settings.image_position == 'right' %} image-with-text--reverse{% endif %}">

      <div class="image-with-text__media">
        {%- if section.settings.image != blank -%}
          <img
            src="{{ section.settings.image | image_url: width: 900 }}"
            alt="{{ section.settings.image.alt | escape | default: section.settings.heading }}"
            width="{{ section.settings.image.width }}"
            height="{{ section.settings.image.height }}"
            loading="lazy"
            class="image-with-text__image"
          >
        {%- else -%}
          {{ 'image' | placeholder_svg_tag: 'image-with-text__image' }}
        {%- endif -%}
      </div>

      <div class="image-with-text__content">
        {%- if section.settings.eyebrow != blank -%}
          <p class="image-with-text__eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        <h2 class="image-with-text__title" {% if section.settings.background == 'dark' %}style="color:var(--color-white)"{% endif %}>
          {{ section.settings.heading }}
        </h2>
        {%- if section.settings.text != blank -%}
          <div class="image-with-text__text">{{ section.settings.text }}</div>
        {%- endif -%}

        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'feature' -%}
              <div class="feature-item" style="display:flex;gap:0.75rem;margin-bottom:1rem;align-items:flex-start" {{ block.shopify_attributes }}>
                <span style="font-size:1.5rem;flex-shrink:0">{{ block.settings.icon }}</span>
                <div>
                  <p style="font-weight:700;font-size:0.9375rem;margin-bottom:0.25rem">{{ block.settings.title }}</p>
                  <p style="font-size:0.875rem;color:var(--color-gray-600)">{{ block.settings.text }}</p>
                </div>
              </div>
          {%- endcase -%}
        {%- endfor -%}

        {%- if section.settings.button_label != blank -%}
          <a href="{{ section.settings.button_link }}" class="btn btn--{{ section.settings.button_style }}">{{ section.settings.button_label }}</a>
        {%- endif -%}
      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Image with Text",
  "settings": [
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "options": [
        { "value": "white", "label": "White" },
        { "value": "light", "label": "Light Warm" },
        { "value": "dark", "label": "Dark" }
      ],
      "default": "white"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image Position",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Why HLBLY?"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>We believe great food starts with great ingredients. Everything we make is crafted with care and delivered fresh to your door.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "Button Style",
      "options": [
        { "value": "primary", "label": "Primary (Red)" },
        { "value": "dark", "label": "Dark" },
        { "value": "outline", "label": "Outline" }
      ],
      "default": "primary"
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature Item",
      "settings": [
        {
          "type": "text",
          "id": "icon",
          "label": "Emoji Icon",
          "default": "✓"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Feature Title"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Description",
          "default": "Brief description of this feature."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Image with Text",
      "blocks": [
        { "type": "feature", "settings": { "icon": "🌿", "title": "Natural Ingredients", "text": "No artificial additives, ever." } },
        { "type": "feature", "settings": { "icon": "🚀", "title": "Fast Delivery", "text": "Dispatched same day before 2pm." } },
        { "type": "feature", "settings": { "icon": "♻️", "title": "Sustainable Packaging", "text": "100% recyclable and compostable." } }
      ]
    }
  ]
}
{% endschema %}
