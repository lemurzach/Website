<div class="product-page">
  <div class="container">
    {% render 'breadcrumbs' %}

    <div class="product-layout">

      <!-- ─── Gallery ─── -->
      <div class="pg-gallery">
        <div class="pg-main" id="pg-main">
          {%- if product.featured_image -%}
            <img
              src="{{ product.featured_image | image_url: width: 900 }}"
              alt="{{ product.featured_image.alt | escape | default: product.title }}"
              id="pg-main-img"
              width="{{ product.featured_image.width }}"
              height="{{ product.featured_image.height }}"
              loading="eager"
              fetchpriority="high"
            >
          {%- else -%}
            {{ 'product-1' | placeholder_svg_tag }}
          {%- endif -%}
        </div>

        {%- if product.images.size > 1 -%}
          <div class="pg-thumbs">
            {%- for img in product.images -%}
              <button
                class="pg-thumb{% if forloop.first %} is-active{% endif %}"
                onclick="selectThumb(this, '{{ img | image_url: width: 900 }}')"
                aria-label="View image {{ forloop.index }}"
              >
                <img
                  src="{{ img | image_url: width: 150, height: 150, crop: 'center' }}"
                  alt="{{ img.alt | escape }}"
                  loading="lazy"
                  width="72" height="72"
                >
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      <!-- ─── Product Info ─── -->
      <div class="pi">

        {%- if product.vendor != blank -%}
          <p class="pi__vendor">{{ product.vendor }}</p>
        {%- endif -%}

        <h1 class="pi__title">{{ product.title }}</h1>

        <!-- Rating placeholder -->
        {%- if section.settings.show_rating -%}
          <div class="pi__rating">
            <span class="pi__stars">★★★★★</span>
            <span class="pi__review-ct">4.9 · 127 reviews</span>
          </div>
        {%- endif -%}

        <!-- Price -->
        <div class="pi__price">
          <span class="price{% if product.compare_at_price > product.price %} price--on{% endif %}" data-price>
            {{ product.price | money }}
          </span>
          {%- if product.compare_at_price > product.price -%}
            <span class="price price--was" data-compare-price>{{ product.compare_at_price | money }}</span>
          {%- endif -%}
        </div>

        <!-- Attribute badges from tags -->
        {%- assign show_attrs = false -%}
        {%- for tag in product.tags -%}
          {%- if tag == 'vegan' or tag == 'Vegan' or tag == 'gluten-free' or tag == 'Gluten Free' or tag contains 'kcal:' or tag contains 'attr:' -%}
            {%- assign show_attrs = true -%}
          {%- endif -%}
        {%- endfor -%}
        {%- if show_attrs -%}
          <div class="pi__attrs">
            {%- for tag in product.tags -%}
              {%- if tag == 'vegan' or tag == 'Vegan' -%}
                <span class="badge badge--vegan">Vegan</span>
              {%- elsif tag == 'gluten-free' or tag == 'Gluten Free' -%}
                <span class="badge badge--gf">Gluten Free</span>
              {%- elsif tag contains 'kcal:' -%}
                <span class="badge badge--custom">{{ tag | remove: 'kcal:' | strip }} kcal</span>
              {%- elsif tag contains 'attr:' -%}
                <span class="badge badge--custom">{{ tag | remove: 'attr:' | strip }}</span>
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- endif -%}

        <div class="pi__divider"></div>

        <!-- Product Form -->
        {%- form 'product', product, data-product-form: '', id: 'product-form' -%}
          <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">

          {%- unless product.has_only_default_variant -%}
            {%- for option in product.options_with_values -%}
              <div class="variant-group">
                <p class="variant-label">
                  {{ option.name }}
                  <span>— {{ option.selected_value }}</span>
                </p>

                {%- assign is_color = false -%}
                {%- if option.name == 'Color' or option.name == 'Colour' or option.name == 'Flavor' or option.name == 'Flavour' -%}
                  {%- assign is_color = true -%}
                {%- endif -%}

                {%- if is_color -%}
                  <div class="color-swatches">
                    {%- for val in option.values -%}
                      <label title="{{ val }}">
                        <input
                          type="radio"
                          name="options[{{ option.name | escape }}]"
                          value="{{ val | escape }}"
                          data-option
                          {% if option.selected_value == val %}checked{% endif %}
                          style="display:none"
                        >
                        <span
                          class="c-swatch{% if option.selected_value == val %} is-on{% endif %}"
                          style="background:{{ val | downcase | replace: ' ', '' }}"
                          onclick="this.previousElementSibling.click();this.closest('.color-swatches').querySelectorAll('.c-swatch').forEach(s=>s.classList.remove('is-on'));this.classList.add('is-on')"
                        ></span>
                      </label>
                    {%- endfor -%}
                  </div>
                {%- else -%}
                  <div class="size-btns">
                    {%- for val in option.values -%}
                      <label>
                        <input
                          type="radio"
                          name="options[{{ option.name | escape }}]"
                          value="{{ val | escape }}"
                          data-option
                          {% if option.selected_value == val %}checked{% endif %}
                          style="display:none"
                        >
                        <span
                          class="sz-btn{% if option.selected_value == val %} is-on{% endif %}"
                          onclick="this.previousElementSibling.click();this.closest('.size-btns').querySelectorAll('.sz-btn').forEach(s=>s.classList.remove('is-on'));this.classList.add('is-on')"
                        >{{ val }}</span>
                      </label>
                    {%- endfor -%}
                  </div>
                {%- endif -%}
              </div>
            {%- endfor -%}
          {%- endunless -%}

          <!-- Qty + Add to Cart -->
          <div class="pi__add-row">
            <div class="qty-wrap">
              <button type="button" class="qty-btn" data-qty-minus aria-label="Decrease">−</button>
              <input type="number" name="quantity" value="1" min="1" class="qty-input" aria-label="Quantity">
              <button type="button" class="qty-btn" data-qty-plus aria-label="Increase">+</button>
            </div>
            <button
              type="submit"
              class="btn btn--primary btn--xl btn--full"
              data-atc
              data-atc-text="{{ 'Add to Cart' }}"
              {%- unless product.selected_or_first_available_variant.available -%}disabled{%- endunless -%}
            >
              {%- if product.selected_or_first_available_variant.available -%}Add to Cart{%- else -%}Sold Out{%- endif -%}
            </button>
          </div>

        {%- endform -%}

        <!-- Mini trust row -->
        <div class="pi__trust">
          {%- if section.settings.trust_1 != blank -%}
            <div class="pi__trust-item"><span>🚚</span>{{ section.settings.trust_1 }}</div>
          {%- endif -%}
          {%- if section.settings.trust_2 != blank -%}
            <div class="pi__trust-item"><span>↩️</span>{{ section.settings.trust_2 }}</div>
          {%- endif -%}
          {%- if section.settings.trust_3 != blank -%}
            <div class="pi__trust-item"><span>🔒</span>{{ section.settings.trust_3 }}</div>
          {%- endif -%}
        </div>

        <!-- Tabs: Description / Details / Shipping -->
        <div class="pi__tabs">
          <div class="tabs-nav">
            <button class="tab-btn is-on" data-tab-target="description">Description</button>
            {%- if section.settings.details_content != blank -%}
              <button class="tab-btn" data-tab-target="details">Details</button>
            {%- endif -%}
            {%- if section.settings.shipping_content != blank -%}
              <button class="tab-btn" data-tab-target="shipping">Shipping</button>
            {%- endif -%}
          </div>

          <div class="tab-panel is-on" data-tab="description">
            {%- if product.description != blank -%}
              {{ product.description }}
            {%- else -%}
              <p>No description available.</p>
            {%- endif -%}
          </div>

          {%- if section.settings.details_content != blank -%}
            <div class="tab-panel" data-tab="details">{{ section.settings.details_content }}</div>
          {%- endif -%}

          {%- if section.settings.shipping_content != blank -%}
            <div class="tab-panel" data-tab="shipping">{{ section.settings.shipping_content }}</div>
          {%- endif -%}
        </div>

      </div>
    </div>
  </div>
</div>

<!-- Sticky ATC bar -->
<div class="sticky-atc" id="sticky-atc">
  <div class="sticky-atc__info">
    <p class="sticky-atc__title" id="sticky-atc-title">{{ product.title }}</p>
    <p class="sticky-atc__price" id="sticky-atc-price">{{ product.price | money }}</p>
  </div>
  <button
    class="btn btn--primary"
    id="sticky-atc-btn"
    data-sticky-atc
    {%- unless product.selected_or_first_available_variant.available -%}disabled{%- endunless -%}
  >
    {%- if product.selected_or_first_available_variant.available -%}Add to Cart{%- else -%}Sold Out{%- endif -%}
  </button>
</div>

<script>
  window.productVariants = {{ product.variants | json }};

  function selectThumb(btn, src) {
    document.querySelectorAll('.pg-thumb').forEach(t => t.classList.remove('is-active'));
    btn.classList.add('is-active');
    const img = document.getElementById('pg-main-img');
    if (img) img.src = src;
  }
</script>

{% schema %}
{
  "name": "Product",
  "settings": [
    { "type": "checkbox", "id": "show_rating",  "label": "Show star rating placeholder", "default": true },
    { "type": "text",     "id": "trust_1",      "label": "Trust badge 1", "default": "Free shipping over $50" },
    { "type": "text",     "id": "trust_2",      "label": "Trust badge 2", "default": "Easy 30-day returns" },
    { "type": "text",     "id": "trust_3",      "label": "Trust badge 3", "default": "Secure checkout" },
    { "type": "richtext", "id": "details_content",  "label": "Details tab content" },
    { "type": "richtext", "id": "shipping_content", "label": "Shipping tab content",
      "default": "<p><strong>Standard Shipping:</strong> 3–5 business days.</p><p><strong>Express Shipping:</strong> 1–2 business days.</p><p>Free standard shipping on orders over $50.</p>" }
  ]
}
{% endschema %}
