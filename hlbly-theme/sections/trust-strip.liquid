<div class="trust-strip">
  <div class="container">
    <div class="trust-strip__inner">
      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'item' -%}
            <div class="trust-item" {{ block.shopify_attributes }}>
              <div class="trust-item__icon">{{ block.settings.icon }}</div>
              <div>
                <p class="trust-item__title">{{ block.settings.title }}</p>
                {%- if block.settings.subtitle != blank -%}
                  <p class="trust-item__sub">{{ block.settings.subtitle }}</p>
                {%- endif -%}
              </div>
            </div>
          {%- endif -%}
        {%- endfor -%}
      {%- else -%}
        <div class="trust-item"><div class="trust-item__icon">🚚</div><div><p class="trust-item__title">Free Shipping</p><p class="trust-item__sub">On orders over $50</p></div></div>
        <div class="trust-item"><div class="trust-item__icon">🌿</div><div><p class="trust-item__title">Natural Ingredients</p><p class="trust-item__sub">No artificial additives</p></div></div>
        <div class="trust-item"><div class="trust-item__icon">↩️</div><div><p class="trust-item__title">Easy Returns</p><p class="trust-item__sub">30-day hassle-free</p></div></div>
        <div class="trust-item"><div class="trust-item__icon">🔒</div><div><p class="trust-item__title">Secure Checkout</p><p class="trust-item__sub">256-bit SSL encryption</p></div></div>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Trust Strip",
  "settings": [],
  "blocks": [
    {
      "type": "item",
      "name": "Trust Item",
      "settings": [
        { "type": "text", "id": "icon",     "label": "Emoji icon", "default": "🚚" },
        { "type": "text", "id": "title",    "label": "Title",      "default": "Free Shipping" },
        { "type": "text", "id": "subtitle", "label": "Subtitle",   "default": "On orders over $50" }
      ]
    }
  ],
  "presets": [{
    "name": "Trust Strip",
    "blocks": [
      { "type": "item", "settings": { "icon": "🚚", "title": "Free Shipping",       "subtitle": "On orders over $50"      } },
      { "type": "item", "settings": { "icon": "🌿", "title": "Natural Ingredients", "subtitle": "No artificial additives" } },
      { "type": "item", "settings": { "icon": "↩️", "title": "Easy Returns",        "subtitle": "30-day hassle-free"      } },
      { "type": "item", "settings": { "icon": "🔒", "title": "Secure Checkout",     "subtitle": "256-bit SSL encryption"  } }
    ]
  }]
}
{% endschema %}
