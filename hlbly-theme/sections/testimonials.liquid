<section class="testimonials section-padding">
  <div class="container">
    <div class="section-header section-header--center">
      {%- if section.settings.eyebrow != blank -%}
        <span class="section-eyebrow">{{ section.settings.eyebrow }}</span>
      {%- endif -%}
      <h2 class="section-title">{{ section.settings.heading }}</h2>
      {%- if section.settings.subheading != blank -%}
        <p class="section-subtitle">{{ section.settings.subheading }}</p>
      {%- endif -%}
    </div>

    <div class="testimonials-grid">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'testimonial' -%}
            <div class="testimonial-card" {{ block.shopify_attributes }}>
              <div class="testimonial-card__stars">
                {%- for i in (1..block.settings.rating) -%}★{%- endfor -%}
              </div>
              <p class="testimonial-card__text">"{{ block.settings.text }}"</p>
              <div style="display:flex;align-items:center;gap:0.75rem">
                {%- if block.settings.author_image != blank -%}
                  <img
                    src="{{ block.settings.author_image | image_url: width: 48, height: 48, crop: 'center' }}"
                    alt="{{ block.settings.author }}"
                    width="48" height="48"
                    style="border-radius:50%;object-fit:cover"
                  >
                {%- else -%}
                  <div style="width:40px;height:40px;border-radius:50%;background:var(--color-primary);display:flex;align-items:center;justify-content:center;color:white;font-weight:800;font-size:0.875rem">
                    {{ block.settings.author | slice: 0, 1 | upcase }}
                  </div>
                {%- endif -%}
                <div>
                  <p class="testimonial-card__author">{{ block.settings.author }}</p>
                  {%- if block.settings.location != blank -%}
                    <p style="font-size:0.75rem;color:var(--color-gray-400)">{{ block.settings.location }}</p>
                  {%- endif -%}
                </div>
              </div>
            </div>
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Testimonials",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Reviews"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What Our Customers Say"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading"
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        {
          "type": "range",
          "id": "rating",
          "label": "Rating",
          "min": 1,
          "max": 5,
          "default": 5
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Review Text",
          "default": "Absolutely love this product. The quality is incredible and delivery was super fast!"
        },
        {
          "type": "text",
          "id": "author",
          "label": "Customer Name",
          "default": "Sarah K."
        },
        {
          "type": "text",
          "id": "location",
          "label": "Location",
          "default": "London, UK"
        },
        {
          "type": "image_picker",
          "id": "author_image",
          "label": "Author Photo (optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Testimonials",
      "blocks": [
        { "type": "testimonial", "settings": { "author": "Sarah K.", "location": "London, UK", "text": "Absolutely love this product. The quality is incredible and delivery was super fast!" } },
        { "type": "testimonial", "settings": { "author": "Marcus T.", "location": "Manchester, UK", "text": "Best purchase I've made this year. Already ordered three more times!" } },
        { "type": "testimonial", "settings": { "author": "Priya M.", "location": "Birmingham, UK", "text": "Premium quality, gorgeous packaging, and it tastes amazing. Highly recommend." } }
      ]
    }
  ]
}
{% endschema %}
