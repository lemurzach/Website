<section class="reviews-section section-pad">
  <div class="container">

    <div class="sh sh--center" data-reveal>
      {%- if section.settings.eyebrow != blank -%}
        <span class="eyebrow">{{ section.settings.eyebrow }}</span>
      {%- endif -%}
      <h2 class="sh__title">{{ section.settings.heading }}</h2>
    </div>

    <div class="reviews-slider">
      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'review' -%}
            <div class="review-card" data-reveal data-reveal-delay="{{ forloop.index }}" {{ block.shopify_attributes }}>
              <div class="review-card__stars">
                {%- assign star_count = block.settings.rating | plus: 0 -%}
                {%- for i in (1..star_count) -%}★{%- endfor -%}
                {%- assign blank_count = 5 | minus: star_count -%}
                {%- if blank_count > 0 -%}
                  {%- for i in (1..blank_count) -%}<span style="opacity:.25">★</span>{%- endfor -%}
                {%- endif -%}
              </div>
              <p class="review-card__text">"{{ block.settings.text }}"</p>
              <div class="review-card__author">
                <div class="review-card__avatar" style="background:var(--c-primary)">
                  {{ block.settings.name | slice: 0, 1 | upcase }}
                </div>
                <div>
                  <p class="review-card__name">{{ block.settings.name }}</p>
                  {%- if block.settings.location != blank -%}
                    <p class="review-card__loc">{{ block.settings.location }}</p>
                  {%- endif -%}
                </div>
              </div>
            </div>
          {%- endif -%}
        {%- endfor -%}
      {%- else -%}
        <div class="review-card" data-reveal>
          <div class="review-card__stars">★★★★★</div>
          <p class="review-card__text">"Absolutely incredible — the boldest flavours I've ever tasted. Already on my third order."</p>
          <div class="review-card__author">
            <div class="review-card__avatar" style="background:var(--c-primary)">S</div>
            <div><p class="review-card__name">Sarah K.</p><p class="review-card__loc">London, UK</p></div>
          </div>
        </div>
        <div class="review-card" data-reveal data-reveal-delay="2">
          <div class="review-card__stars">★★★★★</div>
          <p class="review-card__text">"Came in gorgeous packaging and the taste is unreal. My whole family is obsessed."</p>
          <div class="review-card__author">
            <div class="review-card__avatar" style="background:var(--c-primary)">M</div>
            <div><p class="review-card__name">Marcus T.</p><p class="review-card__loc">Manchester, UK</p></div>
          </div>
        </div>
        <div class="review-card" data-reveal data-reveal-delay="3">
          <div class="review-card__stars">★★★★★</div>
          <p class="review-card__text">"Can't believe how fresh and natural everything is. This is my go-to for gifts now."</p>
          <div class="review-card__author">
            <div class="review-card__avatar" style="background:var(--c-primary)">P</div>
            <div><p class="review-card__name">Priya M.</p><p class="review-card__loc">Birmingham, UK</p></div>
          </div>
        </div>
      {%- endif -%}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Reviews / Testimonials",
  "settings": [
    { "type": "text", "id": "eyebrow",  "label": "Eyebrow",  "default": "Reviews"                    },
    { "type": "text", "id": "heading",  "label": "Heading",  "default": "Loved by Thousands"          }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "range",    "id": "rating",   "label": "Rating",   "min": 1, "max": 5, "default": 5 },
        { "type": "textarea", "id": "text",     "label": "Review",   "default": "Absolutely incredible product!"  },
        { "type": "text",     "id": "name",     "label": "Name",     "default": "Alex M."    },
        { "type": "text",     "id": "location", "label": "Location", "default": "London, UK" }
      ]
    }
  ],
  "presets": [{
    "name": "Reviews / Testimonials",
    "blocks": [
      { "type": "review", "settings": { "rating": 5, "text": "Absolutely incredible — the boldest flavours I've ever tasted.", "name": "Sarah K.", "location": "London, UK" } },
      { "type": "review", "settings": { "rating": 5, "text": "Came in gorgeous packaging and the taste is unreal. Obsessed.", "name": "Marcus T.", "location": "Manchester, UK" } },
      { "type": "review", "settings": { "rating": 5, "text": "Can't believe how fresh and natural everything is.", "name": "Priya M.", "location": "Birmingham, UK" } }
    ]
  }]
}
{% endschema %}
