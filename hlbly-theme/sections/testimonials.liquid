<section class="reviews-section section-pad">
  <div class="container">

    <div class="sh sh--center" data-reveal>
      {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h2 class="sh__title">{{ section.settings.heading }}</h2>
      {%- if section.settings.subheading != blank -%}<p class="sh__sub">{{ section.settings.subheading }}</p>{%- endif -%}
    </div>

    <div class="reviews-slider">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'review' -%}
            <div class="review-card" data-reveal data-reveal-delay="{{ forloop.index }}" {{ block.shopify_attributes }}>
              <div class="review-card__stars">
                {%- for i in (1..block.settings.rating) -%}★{%- endfor -%}
                {%- assign blanks = 5 | minus: block.settings.rating -%}
                {%- for i in (1..blanks) -%}<span style="opacity:.25">★</span>{%- endfor -%}
              </div>
              <p class="review-card__text">"{{ block.settings.text }}"</p>
              <div class="review-card__author">
                {%- if block.settings.avatar != blank -%}
                  <img
                    src="{{ block.settings.avatar | image_url: width: 80, height: 80, crop: 'center' }}"
                    alt="{{ block.settings.name }}"
                    class="review-card__avatar"
                    loading="lazy"
                    width="40" height="40"
                  >
                {%- else -%}
                  <div class="review-card__avatar" style="background:var(--c-primary)">
                    {{ block.settings.name | slice: 0, 1 | upcase }}
                  </div>
                {%- endif -%}
                <div>
                  <p class="review-card__name">{{ block.settings.name }}</p>
                  {%- if block.settings.location != blank -%}
                    <p class="review-card__loc">{{ block.settings.location }}</p>
                  {%- endif -%}
                </div>
              </div>
            </div>
        {%- endcase -%}
      {%- endfor -%}
    </div>

    {%- if section.settings.cta_label != blank -%}
      <div style="text-align:center;margin-top:2.5rem" data-reveal>
        <a href="{{ section.settings.cta_url }}" class="btn btn--outline btn--lg">{{ section.settings.cta_label }}</a>
      </div>
    {%- endif -%}

  </div>
</section>

{% schema %}
{
  "name": "Reviews / Testimonials",
  "settings": [
    { "type": "text", "id": "eyebrow",    "label": "Eyebrow",    "default": "Reviews" },
    { "type": "text", "id": "heading",    "label": "Heading",    "default": "What Our Customers Say" },
    { "type": "text", "id": "subheading", "label": "Subheading" },
    { "type": "text", "id": "cta_label",  "label": "CTA label (optional)" },
    { "type": "url",  "id": "cta_url",    "label": "CTA link"   }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "range",       "id": "rating",   "label": "Rating",   "min": 1, "max": 5, "default": 5 },
        { "type": "textarea",    "id": "text",     "label": "Review",   "default": "Absolutely incredible product. Best I've ever tried!" },
        { "type": "text",        "id": "name",     "label": "Name",     "default": "Alex M."   },
        { "type": "text",        "id": "location", "label": "Location", "default": "London, UK" },
        { "type": "image_picker","id": "avatar",   "label": "Photo (optional)" }
      ]
    }
  ],
  "presets": [{
    "name": "Reviews / Testimonials",
    "blocks": [
      { "type": "review", "settings": { "rating": 5, "text": "Absolutely incredible — the boldest flavours I've ever tasted. Already on my third order.", "name": "Sarah K.", "location": "London, UK" } },
      { "type": "review", "settings": { "rating": 5, "text": "Came in gorgeous packaging and the taste is unreal. My whole family is obsessed.", "name": "Marcus T.", "location": "Manchester, UK" } },
      { "type": "review", "settings": { "rating": 5, "text": "Can't believe how fresh and natural everything is. This is my go-to for gifts now.", "name": "Priya M.", "location": "Birmingham, UK" } }
    ]
  }]
}
{% endschema %}
