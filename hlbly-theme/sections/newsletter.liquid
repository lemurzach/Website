<section class="newsletter newsletter--{{ section.settings.style }}">
  <div class="container">
    <div class="newsletter__inner" data-reveal>
      {%- if section.settings.eyebrow != blank -%}
        <span class="eyebrow" style="justify-content:center{% if section.settings.style == 'dark' or section.settings.style == 'primary' %};color:rgba(255,255,255,.5){% endif %}">{{ section.settings.eyebrow }}</span>
      {%- endif -%}
      <h2 class="newsletter__title">{{ section.settings.heading }}</h2>
      {%- if section.settings.subheading != blank -%}
        <p class="newsletter__sub">{{ section.settings.subheading }}</p>
      {%- endif -%}

      {% form 'customer', data-newsletter: '' %}
        <input type="hidden" name="contact[tags]" value="newsletter,prospect">
        <div class="newsletter__form">
          <input
            type="email"
            name="contact[email]"
            class="newsletter__input"
            placeholder="{{ section.settings.placeholder | default: 'Your email address' }}"
            required
            autocomplete="email"
            aria-label="Email"
          >
          <button type="submit" class="btn btn--primary">{{ section.settings.btn | default: 'Subscribe' }}</button>
        </div>
        {%- if form.posted_successfully? -%}
          <p data-nl-success style="display:block;font-size:.875rem;margin-top:.875rem;color:rgba(255,255,255,.8);font-weight:600">{{ section.settings.success | default: "You're in! 🎉 Check your inbox." }}</p>
        {%- endif -%}
        {%- if form.errors -%}
          <p style="font-size:.8rem;margin-top:.75rem;color:rgba(255,255,255,.65)">{{ form.errors | default_errors }}</p>
        {%- endif -%}
      {% endform %}

      {%- if section.settings.note != blank -%}
        <p class="newsletter__note">{{ section.settings.note }}</p>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    {
      "type": "select", "id": "style", "label": "Style",
      "options": [
        { "value": "dark",    "label": "Dark"          },
        { "value": "primary", "label": "Brand Red"     },
        { "value": "sand",    "label": "Sand / Warm"   }
      ],
      "default": "dark"
    },
    { "type": "text", "id": "eyebrow",     "label": "Eyebrow" },
    { "type": "text", "id": "heading",     "label": "Heading",     "default": "Join the HLBLY Community" },
    { "type": "text", "id": "subheading",  "label": "Subheading",  "default": "Exclusive deals, new flavours and early access — straight to your inbox." },
    { "type": "text", "id": "placeholder", "label": "Input placeholder", "default": "Enter your email" },
    { "type": "text", "id": "btn",         "label": "Button label",      "default": "Subscribe" },
    { "type": "text", "id": "success",     "label": "Success message",   "default": "You're in! 🎉 Check your inbox." },
    { "type": "text", "id": "note",        "label": "Note below form",   "default": "No spam. Unsubscribe anytime." }
  ],
  "presets": [{ "name": "Newsletter" }]
}
{% endschema %}
