{%- assign hero_class = 'hero' -%}
{%- if section.settings.height == 'short' -%}{%- assign hero_class = hero_class | append: ' hero--short' -%}{%- endif -%}
{%- if section.settings.height == 'full' -%}{%- assign hero_class = hero_class | append: ' hero--full' -%}{%- endif -%}
{%- if section.settings.layout == 'split' -%}{%- assign hero_class = hero_class | append: ' hero--split' -%}{%- endif -%}

{% if section.settings.layout == 'split' %}

  <section class="{{ hero_class }}">
    <div class="container">
      <div class="hero__inner">
        <div class="hero__content">
          {%- if section.settings.eyebrow != blank -%}
            <p class="hero__eyebrow">{{ section.settings.eyebrow }}</p>
          {%- endif -%}
          <h1 class="hero__title" style="color:var(--color-dark)">{{ section.settings.heading | newline_to_br }}</h1>
          {%- if section.settings.subheading != blank -%}
            <p class="hero__subtitle" style="color:var(--color-gray-600)">{{ section.settings.subheading }}</p>
          {%- endif -%}
          <div class="hero__actions">
            {%- if section.settings.button_label != blank -%}
              <a href="{{ section.settings.button_link }}" class="btn btn--primary btn--lg">{{ section.settings.button_label }}</a>
            {%- endif -%}
            {%- if section.settings.button_label_2 != blank -%}
              <a href="{{ section.settings.button_link_2 }}" class="btn btn--outline btn--lg">{{ section.settings.button_label_2 }}</a>
            {%- endif -%}
          </div>
        </div>
        <div class="hero__media">
          {%- if section.settings.image != blank -%}
            <img
              src="{{ section.settings.image | image_url: width: 1000 }}"
              alt="{{ section.settings.image.alt | escape | default: section.settings.heading }}"
              width="{{ section.settings.image.width }}"
              height="{{ section.settings.image.height }}"
              loading="eager"
              fetchpriority="high"
              class="hero__image"
            >
          {%- else -%}
            <div style="background:var(--color-gray-200);width:100%;height:100%;display:flex;align-items:center;justify-content:center;font-size:0.875rem;color:var(--color-gray-400)">Add hero image</div>
          {%- endif -%}
        </div>
      </div>
    </div>
  </section>

{% else %}

  <section class="{{ hero_class }}">
    <div class="hero__media">
      {%- if section.settings.image != blank -%}
        <img
          src="{{ section.settings.image | image_url: width: 2000 }}"
          alt="{{ section.settings.image.alt | escape | default: section.settings.heading }}"
          width="{{ section.settings.image.width }}"
          height="{{ section.settings.image.height }}"
          loading="eager"
          fetchpriority="high"
          class="hero__image"
        >
      {%- else -%}
        <div style="background:var(--color-dark);width:100%;height:100%"></div>
      {%- endif -%}
    </div>
    <div class="hero__overlay" style="background:linear-gradient(to right, rgba(0,0,0,{{ section.settings.overlay_opacity | divided_by: 100.0 }}) 0%, rgba(0,0,0,{{ section.settings.overlay_opacity | divided_by: 200.0 }}) 70%)"></div>
    <div class="container" style="position:relative;z-index:2">
      <div class="hero__content">
        {%- if section.settings.eyebrow != blank -%}
          <p class="hero__eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        <h1 class="hero__title">{{ section.settings.heading | newline_to_br }}</h1>
        {%- if section.settings.subheading != blank -%}
          <p class="hero__subtitle">{{ section.settings.subheading }}</p>
        {%- endif -%}
        <div class="hero__actions">
          {%- if section.settings.button_label != blank -%}
            <a href="{{ section.settings.button_link }}" class="btn btn--primary btn--lg">{{ section.settings.button_label }}</a>
          {%- endif -%}
          {%- if section.settings.button_label_2 != blank -%}
            <a href="{{ section.settings.button_link_2 }}" class="btn btn--outline-white btn--lg">{{ section.settings.button_label_2 }}</a>
          {%- endif -%}
        </div>
      </div>
    </div>
  </section>

{% endif %}

{% schema %}
{
  "name": "Hero Banner",
  "settings": [
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "overlay", "label": "Image with Overlay" },
        { "value": "split", "label": "Split (Image + Content)" }
      ],
      "default": "overlay"
    },
    {
      "type": "select",
      "id": "height",
      "label": "Height",
      "options": [
        { "value": "short", "label": "Short (60vh)" },
        { "value": "medium", "label": "Medium (85vh)" },
        { "value": "full", "label": "Full Screen" }
      ],
      "default": "medium"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero Image"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay Opacity",
      "min": 0,
      "max": 90,
      "step": 5,
      "default": 55,
      "unit": "%"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "New Collection"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "Bold Flavors\nfor Bold People"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Discover our handcrafted range of premium food and drink."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button 1 Label",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button 1 Link"
    },
    {
      "type": "text",
      "id": "button_label_2",
      "label": "Button 2 Label"
    },
    {
      "type": "url",
      "id": "button_link_2",
      "label": "Button 2 Link"
    }
  ],
  "presets": [
    {
      "name": "Hero Banner"
    }
  ]
}
{% endschema %}
