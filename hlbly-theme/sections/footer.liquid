<footer class="site-footer" role="contentinfo">
  <div class="container">
    <div class="footer-grid">

      <!-- Brand Column -->
      <div class="footer-brand">
        <div class="footer-logo">
          {%- if section.settings.logo != blank -%}
            <img src="{{ section.settings.logo | image_url: width: 200 }}" alt="{{ shop.name }}" width="160">
          {%- else -%}
            <span>{{ shop.name | split: '' | first }}<span style="color:var(--color-primary)">{{ shop.name | slice: 1, 100 }}</span></span>
          {%- endif -%}
        </div>
        {%- if section.settings.brand_description != blank -%}
          <p class="footer-brand__desc">{{ section.settings.brand_description }}</p>
        {%- endif -%}
        <div class="footer-social">
          {%- if section.settings.instagram_url != blank -%}
            <a href="{{ section.settings.instagram_url }}" class="footer-social__link" target="_blank" rel="noopener" aria-label="Instagram">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none">
                <rect x="2" y="2" width="20" height="20" rx="5" stroke="currentColor" stroke-width="1.5"/>
                <circle cx="12" cy="12" r="5" stroke="currentColor" stroke-width="1.5"/>
                <circle cx="17.5" cy="6.5" r="1" fill="currentColor"/>
              </svg>
            </a>
          {%- endif -%}
          {%- if section.settings.tiktok_url != blank -%}
            <a href="{{ section.settings.tiktok_url }}" class="footer-social__link" target="_blank" rel="noopener" aria-label="TikTok">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                <path d="M19.59 6.69a4.83 4.83 0 01-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 01-2.88 2.5 2.89 2.89 0 01-2.89-2.89 2.89 2.89 0 012.89-2.89c.28 0 .54.04.79.1V9.01a6.3 6.3 0 00-.79-.05 6.34 6.34 0 00-6.34 6.34 6.34 6.34 0 006.34 6.34 6.34 6.34 0 006.33-6.34V8.69a8.18 8.18 0 004.78 1.52V6.77a4.85 4.85 0 01-1.01-.08z"/>
              </svg>
            </a>
          {%- endif -%}
          {%- if section.settings.facebook_url != blank -%}
            <a href="{{ section.settings.facebook_url }}" class="footer-social__link" target="_blank" rel="noopener" aria-label="Facebook">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                <path d="M18 2h-3a5 5 0 00-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 011-1h3z"/>
              </svg>
            </a>
          {%- endif -%}
        </div>
      </div>

      <!-- Link Columns -->
      {% for block in section.blocks %}
        {% case block.type %}
          {% when 'link_column' %}
            <div class="footer-column">
              <p class="footer-column__title">{{ block.settings.title }}</p>
              <ul class="footer-links">
                {% for link in block.settings.menu.links %}
                  <li><a href="{{ link.url }}">{{ link.title }}</a></li>
                {% endfor %}
              </ul>
            </div>
        {% endcase %}
      {% endfor %}

    </div>
  </div>

  <div class="footer-bottom">
    <div class="container" style="width:100%">
      <div class="footer-bottom" style="border-top:none;padding:0">
        <p class="footer-bottom__copy">
          &copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. All rights reserved.
          {%- if section.settings.show_policy_links -%}
            &nbsp;&middot;&nbsp;
            <a href="{{ shop.privacy_policy.url }}" style="color:rgba(255,255,255,0.4)">Privacy Policy</a>
            &nbsp;&middot;&nbsp;
            <a href="{{ shop.refund_policy.url }}" style="color:rgba(255,255,255,0.4)">Refund Policy</a>
          {%- endif -%}
        </p>
        <div class="footer-bottom__payments">
          <div class="payment-icon">VISA</div>
          <div class="payment-icon">MC</div>
          <div class="payment-icon">AMEX</div>
          <div class="payment-icon">PYPL</div>
          <div class="payment-icon">SHPY</div>
        </div>
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "limit": 1,
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Footer Logo"
    },
    {
      "type": "textarea",
      "id": "brand_description",
      "label": "Brand Description",
      "default": "Premium quality, delivered to your door."
    },
    {
      "type": "url",
      "id": "instagram_url",
      "label": "Instagram URL"
    },
    {
      "type": "url",
      "id": "tiktok_url",
      "label": "TikTok URL"
    },
    {
      "type": "url",
      "id": "facebook_url",
      "label": "Facebook URL"
    },
    {
      "type": "checkbox",
      "id": "show_policy_links",
      "label": "Show Policy Links",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "link_column",
      "name": "Link Column",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Column Title",
          "default": "Links"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Footer",
      "blocks": [
        { "type": "link_column", "settings": { "title": "Shop" } },
        { "type": "link_column", "settings": { "title": "Company" } },
        { "type": "link_column", "settings": { "title": "Support" } }
      ]
    }
  ]
}
{% endschema %}
