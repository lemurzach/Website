{%- assign bg = '' -%}
{%- if section.settings.background == 'sand' -%}{%- assign bg = 'var(--c-sand)' -%}{%- endif -%}
{%- if section.settings.background == 'dark' -%}{%- assign bg = 'var(--c-dark)' -%}{%- endif -%}

<section class="section-pad" style="{% if bg != '' %}background:{{ bg }};{% endif %}{% if section.settings.background == 'dark' %}color:var(--c-white);{% endif %}">
  <div class="container">
    {%- if section.settings.heading != blank -%}
      <div class="sh sh--center" style="margin-bottom:3rem" data-reveal>
        {%- if section.settings.eyebrow != blank -%}
          <span class="eyebrow">{{ section.settings.eyebrow }}</span>
        {%- endif -%}
        <h2 class="sh__title">{{ section.settings.heading }}</h2>
      </div>
    {%- endif -%}
    <div class="stats-row">
      {%- if section.blocks.size > 0 -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'stat' -%}
          {%- assign card_style = '' -%}
          {%- if section.settings.background == 'dark' -%}{%- assign card_style = 'background:rgba(255,255,255,.06)' -%}{%- endif -%}
          <div class="stat-card" style="{{ card_style }}" data-reveal data-reveal-delay="{{ forloop.index }}" {{ block.shopify_attributes }}>
            <div
              class="stat-card__num"
              data-counter="{{ block.settings.number }}"
              data-suffix="{{ block.settings.suffix }}"
              data-prefix="{{ block.settings.prefix }}"
            >{{ block.settings.prefix }}{{ block.settings.number }}{{ block.settings.suffix }}</div>
            <div class="stat-card__label" style="{% if section.settings.background == 'dark' %}color:rgba(255,255,255,.5){% endif %}">{{ block.settings.label }}</div>
          </div>
        {%- endif -%}
      {%- endfor -%}
      {%- else -%}
        <div class="stat-card" data-reveal><div class="stat-card__num" data-counter="5000" data-suffix="+">5000+</div><div class="stat-card__label">Happy Customers</div></div>
        <div class="stat-card" data-reveal data-reveal-delay="2"><div class="stat-card__num" data-counter="12" data-suffix="+">12+</div><div class="stat-card__label">Unique Flavours</div></div>
        <div class="stat-card" data-reveal data-reveal-delay="3"><div class="stat-card__num" data-counter="4.9" data-suffix="★">4.9★</div><div class="stat-card__label">Average Rating</div></div>
        <div class="stat-card" data-reveal data-reveal-delay="4"><div class="stat-card__num" data-counter="100" data-suffix="%">100%</div><div class="stat-card__label">Natural Ingredients</div></div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Stats / Numbers",
  "settings": [
    {
      "type": "select", "id": "background", "label": "Background",
      "options": [
        { "value": "white", "label": "White" },
        { "value": "sand",  "label": "Sand"  },
        { "value": "dark",  "label": "Dark"  }
      ],
      "default": "sand"
    },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading" }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Stat",
      "settings": [
        { "type": "text", "id": "prefix", "label": "Prefix (e.g. £, $)" },
        { "type": "text", "id": "number", "label": "Number", "default": "5000" },
        { "type": "text", "id": "suffix", "label": "Suffix (e.g. +, %)",  "default": "+" },
        { "type": "text", "id": "label",  "label": "Label",               "default": "Happy Customers" }
      ]
    }
  ],
  "presets": [{
    "name": "Stats / Numbers",
    "blocks": [
      { "type": "stat", "settings": { "number": "5000", "suffix": "+", "label": "Happy Customers"    } },
      { "type": "stat", "settings": { "number": "12",   "suffix": "+", "label": "Unique Flavours"    } },
      { "type": "stat", "settings": { "number": "4.9",  "suffix": "★", "label": "Average Rating"     } },
      { "type": "stat", "settings": { "number": "100",  "suffix": "%", "label": "Natural Ingredients" } }
    ]
  }]
}
{% endschema %}
