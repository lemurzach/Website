<div style="padding:var(--spacing-xl) 0">
  <div class="container">
    <div class="article-content">
      {% render 'breadcrumbs' %}
      <p class="blog-card__meta" style="margin-bottom:1rem">{{ article.published_at | date: '%B %d, %Y' }} &middot; {{ article.author }}</p>
      <h1 style="font-size:clamp(2rem,4vw,3rem);font-weight:900;margin-bottom:1.5rem;letter-spacing:-0.02em">{{ article.title }}</h1>
      {%- if article.image -%}
        <div style="aspect-ratio:16/9;border-radius:var(--radius-lg);overflow:hidden;margin-bottom:2rem">
          <img src="{{ article.image | image_url: width: 1200 }}" alt="{{ article.image.alt | escape }}" style="width:100%;height:100%;object-fit:cover">
        </div>
      {%- endif -%}
      {{ article.content }}

      {%- if article.tags.size > 0 -%}
        <div style="margin-top:2.5rem;padding-top:1.5rem;border-top:1px solid var(--color-gray-200)">
          <p style="font-size:0.75rem;font-weight:700;text-transform:uppercase;letter-spacing:0.1em;margin-bottom:0.75rem">Tags</p>
          <div style="display:flex;flex-wrap:wrap;gap:0.5rem">
            {%- for tag in article.tags -%}
              <a href="{{ blog.url }}/tagged/{{ tag | handle }}" style="padding:0.375rem 0.875rem;border:1px solid var(--color-gray-200);border-radius:var(--radius-pill);font-size:0.8125rem;font-weight:500;transition:all 0.2s">{{ tag }}</a>
            {%- endfor -%}
          </div>
        </div>
      {%- endif -%}

      <div style="margin-top:2.5rem">
        <a href="{{ blog.url }}" class="btn btn--outline">&larr; Back to {{ blog.title }}</a>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Article"
}
{% endschema %}
