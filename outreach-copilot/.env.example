# Required — see README.md "Deployment" section for how to get each of these
ANTHROPIC_API_KEY=
DATABASE_URL="postgresql://user:password@host:5432/dbname"
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Required in production (a fixed deployment URL). Not needed on Vercel,
# which sets this automatically — needed for any other host.
# AUTH_URL="https://your-domain.com"

# Optional — model override (defaults to claude-opus-5)
ANTHROPIC_MODEL=claude-opus-5

# Optional — raises the free PageSpeed Insights quota
GOOGLE_PAGESPEED_API_KEY=

# Optional — enables ad-activity lookups via the Meta Ad Library API
# Get one from a Meta developer app with the ads_read permission.
META_AD_LIBRARY_ACCESS_TOKEN=

# Used as a fallback sender context if a signed-in user's own display
# name/context isn't enough context for the draft.
SENDER_CONTEXT="I help companies improve their outreach and marketing operations."
